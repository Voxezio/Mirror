# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Shared secret key for communication with your bot
MIRROR_SECRET_KEY=your_mirror_secret_key_here

# Telegram Serverless Queue URL (e.g. https://app<app_id>.tgcloud.ai/api/queue)
TGCLOUD_QUEUE_URL=

# Enable Queue Polling (true / false)
POLL_QUEUE=true
POLL_INTERVAL=5.0

# Optional: MTProto API credentials from https://my.telegram.org/ (enables 2000 MB / 2 GB uploads)
# If left empty, the service uses Telegram Bot API multipart upload (up to 50 MB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: Proxy for downloading videos from protected CDNs
# Format: http://user:pass@host:port or http://host:port
HTTP_PROXY=
HTTPS_PROXY=

# Server settings
PORT=7860
HOST=0.0.0.0
